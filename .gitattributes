* text=auto eol=lf
# Keep protocol markers and companion scripts identical on Windows checkouts.
tests/.frostbyte-agent-test-workspace text eol=lf
# License inventories refer to the original bytes, including upstream CRLF.
licenses/** -text
# Upstream license notices are retained byte-for-byte, including line-end spaces.
licenses/ipfs/** whitespace=-blank-at-eol,-blank-at-eof linguist-vendored
LICENSES.third-party.txt -text whitespace=-blank-at-eol,-blank-at-eof linguist-generated
# Vite output preserves whitespace inside upstream Monaco template literals.
src/renderer/studio-v2/** whitespace=-blank-at-eol,-blank-at-eof linguist-generated
