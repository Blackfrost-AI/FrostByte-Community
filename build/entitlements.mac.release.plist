<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs JIT permission under the hardened runtime. All native code in
         a release must remain covered by Developer ID library validation. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
