{
  "name": "blackfrost-hub-api",
  "version": "0.1.0",
  "private": true,
  "description": "Blackfrost Hub API — Firestore-backed discovery, entitlements, and account backend.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "serve": "firebase emulators:start --only functions,firestore --project blackfrost-ai-prod",
    "deploy": "firebase deploy --only functions:hubApi,firestore --project blackfrost-ai-prod"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  }
}